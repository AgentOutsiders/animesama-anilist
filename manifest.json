{
  "manifest_version": 3,
  "name": "AnimeSama-AniList",
  "version": "1.1.0",
  "description": "Connecte tes visionnages Anime-Sama à ton compte AniList.",
  "permissions": [
    "identity",
    "storage"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.anime-sama.to/*"],
      "js": ["scripts/content.js"]
    }
  ],
  "background": {
    "service_worker": "scripts/background.js",
    "scripts": ["scripts/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "animesama-anilist@AgentOutsiders.fr",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "message": "Cette extension utilise uniquement le stockage local pour les préférences et le jeton d'authentification.",
        "required": ["none"]
      }
    }
  }
}